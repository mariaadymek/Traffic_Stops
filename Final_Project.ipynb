   "source": [
   "#Getting rid of incident number repeats\n",
    "stops_unique = stops.drop_duplicates(subset=['incident_number'])\n",
    "#Making call_time a date variable\n"
    "stops_unique['call_time'] = pd.to_datetime(stops_unique['call_time'])\n"
    "#Making missing variables in Race Null\n"
    "stops_unique = stops_unique.replace('Missing', np.nan)\n"
    "#Getting rid of impossible and missing age values and replacing them with null\n"
    "stops_unique.loc[stops_unique['age'] > 100, 'age'] = np.nan\n"
    "stops_unique.loc[stops_unique['age'] < 10, 'age'] = np.nan\n"
    "stops_unique = stops_unique.replace('NA', np.nan)\n"
    "stops_unique['age'].describe()\n"
    "#Getting rid of the prefix "M" in stop_type\n"
    "stops_unique['stop_type'] = stops_unique['stop_type'].str[4:]\n"
    "stops_unique.head()\n"
   ]
  }
